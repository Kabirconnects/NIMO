{
  "name": "@workspace/server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "test:all": "tsx scripts/server-test.ts",
    "test": "tsx scripts/server-test.ts",
    "ci": "npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.109",
    "@workspace/agents": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/memory": "workspace:*",
    "ai": "^7.0.162",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "jose": "^6.2.17",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^20",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "^10",
    "tsx": "latest",
    "typescript": "^5"
  }
}
