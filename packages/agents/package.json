{
  "name": "@workspace/agents",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "test": "echo 'no tests' && exit 0",
    "ci": "npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.91",
    "@ai-sdk/deepseek": "^3.0.75",
    "@ai-sdk/google": "^4.0.107",
    "@ai-sdk/groq": "^4.0.72",
    "@ai-sdk/openai": "^4.0.104",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "@workspace/memory": "workspace:*",
    "ai": "^7.0.162",
    "ai-sdk-ollama": "^4.6.2",
    "better-sqlite3": "^13.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "^10",
    "tsx": "latest",
    "typescript": "^5"
  }
}
